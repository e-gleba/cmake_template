{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  labels: ["dependencies"],
  commitMessagePrefix: "chore(deps):",

  // Single weekly run — let it open every PR at once instead of trickling
  // 2/hour and parking the rest behind dashboard checkboxes.
  prHourlyLimit: 0,

  // No dashboard issue — updates arrive as PRs directly.
  dependencyDashboard: false,

  // Owned by Dependabot (see dependabot.yml) — never duplicate it here.
  "github-actions": { enabled: false },
  dockerfile: { enabled: false },

  packageRules: [
    {
      description: "Auto-merge safe updates once CI passes",
      matchUpdateTypes: ["patch", "pin"],
      automerge: true,
    },
    {
      description: "Floating branches have no tags to compare — update manually",
      matchDepNames: [
        "libsdl-org/SDL_mixer",
        "libsdl-org/SDL_shadercross",
        "marton78/pffft",
        "nothings/stb",
        "tinyobjloader/tinyobjloader",
      ],
      enabled: false,
    },
  ],

  // No native CPM manager exists — regex over cmake/cpm/*-config.cmake.
  // Renovate writes back the STRIPPED version (no tag prefix), so the pin
  // form must round-trip it — pick by upstream tag style:
  //   tag vX.Y.Z                -> VERSION X.Y.Z  (CPM prepends the v)
  //   tag X.Y.Z (bare)          -> GIT_TAG X.Y.Z  (exact as-is)
  //   VER- / release- / yaml-cpp- tags -> dedicated managers below that
  //   restore the prefix via autoReplaceStringTemplate.
  // Convention (keep it): GITHUB_REPOSITORY first, then one of GIT_TAG or
  // VERSION — never both.
  customManagers: [
    {
      customType: "regex",
      description: "CPM bootstrap itself (cmake/ct_cpm.cmake)",
      managerFilePatterns: ["/(^|/)cmake/ct_cpm\\.cmake$/"],
      matchStrings: [
        "set\\(ct_cpm_version\\s+\"(?<currentValue>[^\"]+)\"\\)",
      ],
      depNameTemplate: "cpm-cmake/CPM.cmake",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "CPM deps pinned by GIT_TAG",
      managerFilePatterns: ["/(^|/)cmake/cpm/[^/]+-config\\.cmake$/"],
      matchStrings: [
        "GITHUB_REPOSITORY\\s+(?<depName>[\\w.-]+/[\\w.-]+)[\\s\\S]*?GIT_TAG\\s+(?<currentValue>[^\\s\"\\)]+)",
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s[\\s\\S]*?GIT_TAG\\s+(?<currentValue>[^\\s\"\\)]+)",
      ],
      datasourceTemplate: "github-tags",
      // Keep the full tag (e.g. "release-3.4.14", "v2.5.3") as currentValue
      // so Renovate writes the complete tag back into GIT_TAG. The
      // versioningTemplate strips the prefix only for comparison.
      extractVersionTemplate: "^(?<version>.+)$",
      versioningTemplate: "^(?:v|release-|VER-|yaml-cpp-)?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      customType: "regex",
      description: "CPM deps pinned by VERSION only (implies GIT_TAG v{VERSION})",
      managerFilePatterns: ["/(^|/)cmake/cpm/[^/]+-config\\.cmake$/"],
      matchStrings: [
        "GITHUB_REPOSITORY\\s+(?<depName>[\\w.-]+/[\\w.-]+)[\\s\\S]*?VERSION\\s+(?<currentValue>\\d[^\\s\"\\)]*)",
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s[\\s\\S]*?VERSION\\s+(?<currentValue>\\d[^\\s\"\\)]*)",
      ],
      datasourceTemplate: "github-tags",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "llvm-mingw toolchain release tag",
      managerFilePatterns: ["/(^|/)cmake/toolchains/llvm_mingw\\.cmake$/"],
      matchStrings: [
        "LLVM_MINGW_VERSION\\s+\"(?<currentValue>[^\"]+)\"",
      ],
      depNameTemplate: "mstorsjo/llvm-mingw",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver-coerced",
    },
  ],
}
