{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  labels: ["dependencies"],
  commitMessagePrefix: "chore(deps):",

  // Single weekly run — let it open every PR at once instead of trickling
  // 2/hour and parking the rest behind dashboard checkboxes.
  prHourlyLimit: 0,

  // No dashboard issue — updates arrive as PRs directly.
  dependencyDashboard: false,

  // Owned by Dependabot (see dependabot.yml) — never duplicate it here.
  "github-actions": { enabled: false },
  dockerfile: { enabled: false },

  packageRules: [
    {
      description: "Auto-merge safe updates once CI passes",
      matchUpdateTypes: ["patch", "pin"],
      automerge: true,
    },
    {
      description: "Floating branches have no tags to compare — update manually",
      matchDepNames: [
        "libsdl-org/SDL_mixer",
        "libsdl-org/SDL_shadercross",
        "marton78/pffft",
        "nothings/stb",
        "tinyobjloader/tinyobjloader",
      ],
      enabled: false,
    },
  ],

  // No native CPM manager exists — regex over cmake/cpm/*-config.cmake.
  // Two pin forms, picked by upstream tag style (CPM prepends the v, so
  // a vX.Y.Z tag is pinned as VERSION X.Y.Z and round-trips exactly):
  //   tag vX.Y.Z                -> VERSION X.Y.Z
  //   tag X.Y.Z (bare)          -> GIT_TAG X.Y.Z
  // Prefixed tags that are NOT bare and NOT v- (release-, yaml-cpp-,
  // VER-x-y-z) stay GIT_TAG and get a dedicated manager below whose
  // regex versioning parses the numeric segments out of the FULL tag.
  // The full tag stays the version throughout: newValue keeps the prefix,
  // the default in-place swap preserves the file structure, and the
  // post-write re-extraction confirms cleanly. (An extractVersionTemplate
  // that strips the prefix breaks this: the stripped newValue no longer
  // matches the re-extracted full tag, and an autoReplaceStringTemplate
  // replaces the whole match region instead of just the value.)
  // Convention (keep it): GITHUB_REPOSITORY first, then one of GIT_TAG or
  // VERSION — never both. The [^()]*? span keeps each match inside one
  // cpmaddpackage() call (a call's own args never contain parens, while
  // crossing into the next call always crosses parens) — this matters for
  // steam_audio-config.cmake, which holds four calls.
  // NOTE: matchStrings run under RE2 — no lookahead/lookbehind allowed.
  // The bare-GIT_TAG manager below excludes prefixed tags with a
  // first-character class instead: every prefixed scheme in use starts
  // with v/V/r/R/y/Y (v, VER-, release-, yaml-cpp-). Branch pins such as
  // main/master still match and stay disabled via packageRules.
  customManagers: [
    {
      customType: "regex",
      description: "CPM bootstrap itself (cmake/ct_cpm.cmake)",
      managerFilePatterns: ["/(^|/)cmake/ct_cpm\\.cmake$/"],
      matchStrings: [
        "set\\(ct_cpm_version\\s+\"(?<currentValue>[^\"]+)\"\\)",
      ],
      depNameTemplate: "cpm-cmake/CPM.cmake",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "CPM deps pinned by GIT_TAG with a bare tag (no prefix)",
      managerFilePatterns: ["/(^|/)cmake/cpm/[^/]+-config\\.cmake$/"],
      matchStrings: [
        "GITHUB_REPOSITORY\\s+(?<depName>[\\w.-]+/[\\w.-]+)[^()]*?GIT_TAG\\s+(?<currentValue>[^vVrRyY\\s\"\\)][^\\s\"\\)]*)",
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s[^()]*?GIT_TAG\\s+(?<currentValue>[^vVrRyY\\s\"\\)][^\\s\"\\)]*)",
      ],
      datasourceTemplate: "github-tags",
      extractVersionTemplate: "^(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "CPM deps pinned by VERSION only (implies GIT_TAG v{VERSION})",
      managerFilePatterns: ["/(^|/)cmake/cpm/[^/]+-config\\.cmake$/"],
      matchStrings: [
        "GITHUB_REPOSITORY\\s+(?<depName>[\\w.-]+/[\\w.-]+)[^()]*?VERSION\\s+(?<currentValue>\\d[^\\s\"\\)]*)",
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s[^()]*?VERSION\\s+(?<currentValue>\\d[^\\s\"\\)]*)",
      ],
      datasourceTemplate: "github-tags",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "freetype: VER-x-y-z tags (dashes; full tag is the version)",
      managerFilePatterns: ["/(^|/)cmake/cpm/freetype-config\\.cmake$/"],
      matchStrings: [
        "GITHUB_REPOSITORY\\s+(?<depName>[\\w.-]+/[\\w.-]+)[^()]*?GIT_TAG\\s+(?<currentValue>[^\\s\"\\)]+)",
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s[^()]*?GIT_TAG\\s+(?<currentValue>[^\\s\"\\)]+)",
      ],
      datasourceTemplate: "github-tags",
      // Same shape as SDL. Bonus: VER- tags now pass isVersion, so the
      // datasource actually returns releases (previously filtered to []).
      versioningTemplate: "regex:^VER-(?<major>\\d+)-(?<minor>\\d+)-(?<patch>\\d+)$",
    },
    {
      customType: "regex",
      description: "SDL: release- tags (full tag is the version)",
      managerFilePatterns: ["/(^|/)cmake/cpm/sdl3-config\\.cmake$/"],
      matchStrings: [
        "GITHUB_REPOSITORY\\s+(?<depName>[\\w.-]+/[\\w.-]+)[^()]*?GIT_TAG\\s+(?<currentValue>[^\\s\"\\)]+)",
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s[^()]*?GIT_TAG\\s+(?<currentValue>[^\\s\"\\)]+)",
      ],
      datasourceTemplate: "github-tags",
      // Full tag stays the version: regex versioning compares the numeric
      // segments, newValue keeps the prefix, and the default in-place swap
      // preserves the file structure (autoReplaceStringTemplate would
      // replace the whole match and break confirmIfDepUpdated).
      versioningTemplate: "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      customType: "regex",
      description: "yaml-cpp: yaml-cpp- tags (full tag is the version)",
      managerFilePatterns: ["/(^|/)cmake/cpm/yaml-cpp-config\\.cmake$/"],
      matchStrings: [
        "GITHUB_REPOSITORY\\s+(?<depName>[\\w.-]+/[\\w.-]+)[^()]*?GIT_TAG\\s+(?<currentValue>[^\\s\"\\)]+)",
        "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s[^()]*?GIT_TAG\\s+(?<currentValue>[^\\s\"\\)]+)",
      ],
      datasourceTemplate: "github-tags",
      // Same shape as SDL (see above).
      versioningTemplate: "regex:^yaml-cpp-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      customType: "regex",
      description: "llvm-mingw toolchain release tag",
      managerFilePatterns: ["/(^|/)cmake/toolchains/llvm_mingw\\.cmake$/"],
      matchStrings: [
        "LLVM_MINGW_VERSION\\s+\"(?<currentValue>[^\"]+)\"",
      ],
      depNameTemplate: "mstorsjo/llvm-mingw",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver-coerced",
    },
  ],
}
