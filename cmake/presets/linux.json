        },
        {
            "name": "linux_clang_x86_64_docs",
            "displayName": "Linux Clang x86_64 documentation",
            "configurePreset": "linux_clang_x86_64",
            "inherits": "build_release",
            "targets": [
                "docs"
            ]
        },
        {
            "name": "linux_gcc_x86_64_release",
            "configurePreset": "linux_gcc_x86_64",
            "inherits": "build_release"
        },
        {
            "name": "linux_gcc_x86_64_debug",
            "configurePreset": "linux_gcc_x86_64",
            "inherits": "build_debug"
        },
        {
            "name": "linux_clang_x86_64_asan_debug",
            "configurePreset": "linux_clang_x86_64_asan",
            "inherits": "build_debug"
        },
        {
            "name": "linux_clang_x86_64_ubsan_debug",
            "configurePreset": "linux_clang_x86_64_ubsan",
            "inherits": "build_debug"
        },
        {
            "name": "linux_clang_x86_64_tsan_debug",
            "configurePreset": "linux_clang_x86_64_tsan",
            "inherits": "build_debug"
        },
        {
            "name": "linux_clang_x86_64_asan_ubsan_debug",
            "configurePreset": "linux_clang_x86_64_asan_ubsan",
            "inherits": "build_debug"
        },
        {
            "name": "linux_clang_x86_64_valgrind_debug",
            "configurePreset": "linux_clang_x86_64_valgrind",
            "inherits": "build_debug"
        },
        {
            "name": "linux_gcc_x86_64_asan_debug",
            "configurePreset": "linux_gcc_x86_64_asan",
            "inherits": "build_debug"
        },
        {
            "name": "linux_gcc_x86_64_ubsan_debug",
            "configurePreset": "linux_gcc_x86_64_ubsan",
            "inherits": "build_debug"
        },
        {
            "name": "linux_gcc_x86_64_tsan_debug",
            "configurePreset": "linux_gcc_x86_64_tsan",
            "inherits": "build_debug"
        },
        {
            "name": "linux_gcc_x86_64_asan_ubsan_debug",
            "configurePreset": "linux_gcc_x86_64_asan_ubsan",
            "inherits": "build_debug"
        },
        {
            "name": "linux_gcc_x86_64_valgrind_debug",
            "configurePreset": "linux_gcc_x86_64_valgrind",
            "inherits": "build_debug"
        }
    ],
    "testPresets": [
