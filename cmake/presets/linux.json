{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 11,
    "include": [
        "base.json",
        "sanitize.json"
    ],
    "configurePresets": [
        {
            "name": "linux_clang_x86_64",
            "displayName": "Linux Clang x86_64",
            "description": "Native Linux x86_64 build with Clang",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CT_CXX_STDLIB": "libc++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux_gcc_x86_64",
            "displayName": "Linux GCC x86_64",
            "description": "Native Linux x86_64 build with GCC",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux_clang_x86_64_asan",
            "displayName": "Linux Clang x86_64 AddressSanitizer",
            "description": "Native Linux x86_64 AddressSanitizer build with Clang; use the linux_clang_x86_64_asan_debug build/test presets",
            "inherits": [
                "linux_clang_x86_64",
                "sanitize_asan"
            ]
        },
        {
            "name": "linux_clang_x86_64_ubsan",
            "displayName": "Linux Clang x86_64 UndefinedBehaviorSanitizer",
            "description": "Native Linux x86_64 UndefinedBehaviorSanitizer build with Clang; use the linux_clang_x86_64_ubsan_debug build/test presets",
            "inherits": [
                "linux_clang_x86_64",
                "sanitize_ubsan"
            ]
        },
        {
            "name": "linux_clang_x86_64_tsan",
            "displayName": "Linux Clang x86_64 ThreadSanitizer",
            "description": "Native Linux x86_64 ThreadSanitizer build with Clang; use the linux_clang_x86_64_tsan_debug build/test presets",
            "inherits": [
                "linux_clang_x86_64",
                "sanitize_tsan"
            ]
        },
        {
            "name": "linux_clang_x86_64_asan_ubsan",
            "displayName": "Linux Clang x86_64 AddressSanitizer + UndefinedBehaviorSanitizer",
            "description": "Native Linux x86_64 combined sanitizer build with Clang; use the linux_clang_x86_64_asan_ubsan_debug build/test presets",
            "inherits": [
                "linux_clang_x86_64",
                "sanitize_asan_ubsan"
            ]
        },
        {
            "name": "linux_clang_x86_64_valgrind",
            "displayName": "Linux Clang x86_64 Valgrind",
            "description": "Native Linux x86_64 build with Clang for Valgrind memcheck (tests run under valgrind via the emulator); use the linux_clang_x86_64_valgrind_debug build/test presets",
            "inherits": [
                "linux_clang_x86_64",
                "valgrind"
            ]
        },
        {
            "name": "linux_gcc_x86_64_asan",
            "displayName": "Linux GCC x86_64 AddressSanitizer",
            "description": "Native Linux x86_64 AddressSanitizer build with GCC; use the linux_gcc_x86_64_asan_debug build/test presets",
            "inherits": [
                "linux_gcc_x86_64",
                "sanitize_asan"
            ]
        },
        {
            "name": "linux_gcc_x86_64_ubsan",
            "displayName": "Linux GCC x86_64 UndefinedBehaviorSanitizer",
            "description": "Native Linux x86_64 UndefinedBehaviorSanitizer build with GCC; use the linux_gcc_x86_64_ubsan_debug build/test presets",
            "inherits": [
                "linux_gcc_x86_64",
                "sanitize_ubsan"
            ]
        },
        {
            "name": "linux_gcc_x86_64_tsan",
            "displayName": "Linux GCC x86_64 ThreadSanitizer",
            "description": "Native Linux x86_64 ThreadSanitizer build with GCC; use the linux_gcc_x86_64_tsan_debug build/test presets",
            "inherits": [
                "linux_gcc_x86_64",
                "sanitize_tsan"
            ]
        },
        {
            "name": "linux_gcc_x86_64_asan_ubsan",
            "displayName": "Linux GCC x86_64 AddressSanitizer + UndefinedBehaviorSanitizer",
            "description": "Native Linux x86_64 combined sanitizer build with GCC; use the linux_gcc_x86_64_asan_ubsan_debug build/test presets",
            "inherits": [
                "linux_gcc_x86_64",
                "sanitize_asan_ubsan"
            ]
        },
        {
            "name": "linux_gcc_x86_64_valgrind",
            "displayName": "Linux GCC x86_64 Valgrind",
            "description": "Native Linux x86_64 build with GCC for Valgrind memcheck (tests run under valgrind via the emulator); use the linux_gcc_x86_64_valgrind_debug build/test presets",
            "inherits": [
                "linux_gcc_x86_64",
                "valgrind"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "linux_clang_x86_64_release",
            "configurePreset": "linux_clang_x86_64",
            "inherits": "build_release"
        },
        {
