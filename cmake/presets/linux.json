{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 12,
    "configurePresets": [
        {
            "name": "linux_clang_x86_64",
            "displayName": "Linux Clang x86_64",
            "description": "Native Linux x86_64 build with Clang",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
        },
        {
            "name": "linux_gcc_x86_64",
            "displayName": "Linux GCC x86_64",
            "description": "Native Linux x86_64 build with GCC",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
        }
    ],
    "buildPresets": [
        {"name": "linux_clang_x86_64_release", "configurePreset": "linux_clang_x86_64", "inherits": "build_release"},
        {"name": "linux_clang_x86_64_debug", "configurePreset": "linux_clang_x86_64", "inherits": "build_debug"},
        {"name": "linux_clang_x86_64_docs", "displayName": "Linux Clang x86_64 documentation", "configurePreset": "linux_clang_x86_64", "inherits": "build_release", "targets": ["docs"]},
        {"name": "linux_gcc_x86_64_release", "configurePreset": "linux_gcc_x86_64", "inherits": "build_release"},
        {"name": "linux_gcc_x86_64_debug", "configurePreset": "linux_gcc_x86_64", "inherits": "build_debug"}
    ],
    "testPresets": [
        {"name": "linux_clang_x86_64_release", "configurePreset": "linux_clang_x86_64", "inherits": "test_base", "configuration": "Release"},
        {"name": "linux_clang_x86_64_debug", "configurePreset": "linux_clang_x86_64", "inherits": "test_base", "configuration": "Debug"},
        {"name": "linux_gcc_x86_64_release", "configurePreset": "linux_gcc_x86_64", "inherits": "test_base", "configuration": "Release"},
        {"name": "linux_gcc_x86_64_debug", "configurePreset": "linux_gcc_x86_64", "inherits": "test_base", "configuration": "Debug"}
    ],
    "packagePresets": [
        {"name": "linux_clang_x86_64_release_tgz", "configurePreset": "linux_clang_x86_64", "configurations": ["Release"], "generators": ["TGZ"]},
        {"name": "linux_gcc_x86_64_release_tgz", "configurePreset": "linux_gcc_x86_64", "configurations": ["Release"], "generators": ["TGZ"]}
    ],
    "workflowPresets": [
        {
            "name": "linux_clang_x86_64_release_package",
            "displayName": "Linux Clang x86_64 release package",
            "description": "Configure, build, test, and package a Linux x86_64 release with Clang",
            "steps": [
                {"type": "configure", "name": "linux_clang_x86_64"},
                {"type": "build", "name": "linux_clang_x86_64_release"},
                {"type": "test", "name": "linux_clang_x86_64_release"},
                {"type": "package", "name": "linux_clang_x86_64_release_tgz"}
            ]
        },
        {
            "name": "linux_gcc_x86_64_release_package",
            "displayName": "Linux GCC x86_64 release package",
            "description": "Configure, build, test, and package a Linux x86_64 release with GCC",
            "steps": [
                {"type": "configure", "name": "linux_gcc_x86_64"},
                {"type": "build", "name": "linux_gcc_x86_64_release"},
                {"type": "test", "name": "linux_gcc_x86_64_release"},
                {"type": "package", "name": "linux_gcc_x86_64_release_tgz"}
            ]
        }
    ]
}
