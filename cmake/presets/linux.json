    "packagePresets": [
        {
            "name": "linux_clang_x86_64_release_tgz",
            "configurePreset": "linux_clang_x86_64",
            "configurations": [
                "Release"
            ],
            "generators": [
                "TGZ"
            ]
        },
        {
            "name": "linux_gcc_x86_64_release_tgz",
            "configurePreset": "linux_gcc_x86_64",
            "configurations": [
                "Release"
            ],
            "generators": [
                "TGZ"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "linux_clang_x86_64_release_package",
            "displayName": "Linux Clang x86_64 release package",
            "description": "Configure, build, test, and package a Linux x86_64 release with Clang",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux_clang_x86_64"
                },
                {
                    "type": "build",
                    "name": "linux_clang_x86_64_release"
                },
                {
                    "type": "test",
                    "name": "linux_clang_x86_64_release"
                },
                {
                    "type": "package",
                    "name": "linux_clang_x86_64_release_tgz"
                }
            ]
        },
        {
            "name": "linux_gcc_x86_64_release_package",
            "displayName": "Linux GCC x86_64 release package",
            "description": "Configure, build, test, and package a Linux x86_64 release with GCC",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux_gcc_x86_64"
                },
                {
                    "type": "build",
                    "name": "linux_gcc_x86_64_release"
                },
                {
                    "type": "test",
                    "name": "linux_gcc_x86_64_release"
                },
                {
                    "type": "package",
                    "name": "linux_gcc_x86_64_release_tgz"
                }
            ]
        }
    ]
}
