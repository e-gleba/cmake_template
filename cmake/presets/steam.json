{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 11,
    "include": [
        "base.json",
        "windows.json"
    ],
    "configurePresets": [
        {
            "name": "steam_base",
            "hidden": true,
            "description": "Shared Steam depot settings: SteamPipe deploy scripts are generated into the build tree (CT_STEAMPIPE), and LTO comes from release_ipo in base.json. Earlier entries in an 'inherits' list win, so this preset is always listed first.",
            "cacheVariables": {
                "CT_STEAMPIPE": "ON"
            }
        },
        {
            "name": "linux_steamrt4_x86_64",
            "displayName": "Linux Steam Runtime 4 (steamrt4) x86_64",
            "description": "Native Linux x86_64 build for Steam Linux Runtime 4.0. Run inside the steamrt4 SDK container (registry.gitlab.steamos.cloud/steamrt/steamrt4/sdk) so the ABI is capped at the runtime baseline.",
            "inherits": [
                "steam_base",
                "release_ipo",
                "base"
            ],
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows_msvc_steam_x86_64",
            "displayName": "Windows MSVC x86_64 (Steam, static CRT)",
            "description": "Windows x86_64 build with MSVC and static CRT (/MT) — no VC++ redistributable dependency in the SteamPipe depot.",
            "inherits": [
                "steam_base",
                "release_ipo",
                "windows_msvc_x86_64"
            ],
            "cacheVariables": {
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            }
        },
        {
            "name": "windows_llvm_mingw_steam_x86_64",
            "displayName": "Windows LLVM-MinGW x86_64 (Steam, static CRT)",
            "description": "Cross-compile Windows x86_64 binaries from Linux with LLVM-MinGW. Depot executables link the non-system runtimes (libc++/libunwind) statically via a per-target genex — UCRT stays a dynamic Windows system import. This preset adds nothing beyond the Steam base.",
            "inherits": [
                "steam_base",
                "release_ipo",
                "windows_llvm_mingw_x86_64"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "linux_steamrt4_x86_64_release",
            "configurePreset": "linux_steamrt4_x86_64",
            "inherits": "build_release"
        },
        {
            "name": "windows_msvc_steam_x86_64_release",
            "configurePreset": "windows_msvc_steam_x86_64",
            "inherits": "build_release"
        },
        {
            "name": "windows_llvm_mingw_steam_x86_64_release",
            "configurePreset": "windows_llvm_mingw_steam_x86_64",
            "inherits": "build_release"
        }
    ],
    "testPresets": [
        {
            "name": "linux_steamrt4_x86_64_release",
            "configurePreset": "linux_steamrt4_x86_64",
            "inherits": "test_base",
            "configuration": "Release"
        },
        {
            "name": "windows_msvc_steam_x86_64_release",
            "configurePreset": "windows_msvc_steam_x86_64",
            "inherits": "test_base",
            "configuration": "Release"
        }
    ],
    "packagePresets": [
        {
            "name": "linux_steamrt4_x86_64_release_zip",
            "configurePreset": "linux_steamrt4_x86_64",
            "configurations": [
                "Release"
            ],
            "generators": [
                "ZIP"
            ]
        },
        {
            "name": "windows_msvc_steam_x86_64_release_zip",
            "configurePreset": "windows_msvc_steam_x86_64",
            "configurations": [
                "Release"
            ],
            "generators": [
                "ZIP"
            ]
        },
        {
            "name": "windows_llvm_mingw_steam_x86_64_release_zip",
            "configurePreset": "windows_llvm_mingw_steam_x86_64",
            "configurations": [
                "Release"
            ],
            "generators": [
                "ZIP"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "linux_steamrt4_x86_64_release_package",
            "displayName": "Linux steamrt4 x86_64 release package",
            "description": "Configure, build, test, and package a Steam Linux Runtime 4.0 release (ZIP, SteamPipe-ready)",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux_steamrt4_x86_64"
                },
                {
                    "type": "build",
                    "name": "linux_steamrt4_x86_64_release"
                },
                {
                    "type": "test",
                    "name": "linux_steamrt4_x86_64_release"
                },
                {
                    "type": "package",
                    "name": "linux_steamrt4_x86_64_release_zip"
                }
            ]
        },
        {
            "name": "windows_msvc_steam_x86_64_release_package",
            "displayName": "Windows MSVC x86_64 Steam release package",
            "description": "Configure, build, test, and package a Windows x86_64 Steam release with static CRT (ZIP, SteamPipe-ready)",
            "steps": [
                {
                    "type": "configure",
                    "name": "windows_msvc_steam_x86_64"
                },
                {
                    "type": "build",
                    "name": "windows_msvc_steam_x86_64_release"
                },
                {
                    "type": "test",
                    "name": "windows_msvc_steam_x86_64_release"
                },
                {
                    "type": "package",
                    "name": "windows_msvc_steam_x86_64_release_zip"
                }
            ]
        },
        {
            "name": "windows_llvm_mingw_steam_x86_64_release_package",
            "displayName": "Windows LLVM-MinGW x86_64 Steam release package",
            "description": "Configure, build, and package a Windows x86_64 Steam release with static CRT; cross-compiled binaries are not tested on Linux",
            "steps": [
                {
                    "type": "configure",
                    "name": "windows_llvm_mingw_steam_x86_64"
                },
                {
                    "type": "build",
                    "name": "windows_llvm_mingw_steam_x86_64_release"
                },
                {
                    "type": "package",
                    "name": "windows_llvm_mingw_steam_x86_64_release_zip"
                }
            ]
        }
    ]
}
