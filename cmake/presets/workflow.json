                { "type": "package", "name": "linux_clang_x86_64_release" }
            ]
        },
        {
            "name": "linux_gcc_x86_64_release",
            "steps": [
                { "type": "configure", "name": "linux_gcc_x86_64" },
                { "type": "build", "name": "linux_gcc_x86_64_release" },
                { "type": "test", "name": "linux_gcc_x86_64_release" },
                { "type": "package", "name": "linux_gcc_x86_64_release" }
            ]
        },
        {
            "name": "wasm_emscripten_wasm32_release",
            "steps": [
                { "type": "configure", "name": "wasm_emscripten_wasm32" },
                { "type": "build", "name": "wasm_emscripten_wasm32_release" },
                { "type": "test", "name": "wasm_emscripten_wasm32_release" }
            ]
        }
