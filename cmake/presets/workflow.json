                { "type": "configure", "name": "android_ndk_x86_64" },
                { "type": "build", "name": "android_ndk_x86_64_release" }
            ]
        },
        {
            "name": "windows_msvc_x86_64_release",
            "steps": [
                { "type": "configure", "name": "windows_msvc_x86_64" },
                { "type": "build", "name": "windows_msvc_x86_64_release" },
                { "type": "test", "name": "windows_msvc_x86_64_release" },
                { "type": "package", "name": "windows_msvc_x86_64_release" }
            ]
        },
        {
            "name": "windows_llvm_mingw_i686_release",
            "steps": [
