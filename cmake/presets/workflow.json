{
    "version": 12,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON",
                "FETCHCONTENT_QUIET": "OFF",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "android_base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_HOME}",
                "CMAKE_ANDROID_STL_TYPE": "c++_shared",
                "CMAKE_ANDROID_API": "24"
            }
        },
        { "name": "android_ndk_arm64_v8a", "inherits": "android_base", "cacheVariables": { "CMAKE_ANDROID_ARCH_ABI": "arm64-v8a" } },
        { "name": "android_ndk_armeabi_v7a", "inherits": "android_base", "cacheVariables": { "CMAKE_ANDROID_ARCH_ABI": "armeabi-v7a" } },
        { "name": "android_ndk_x86_64", "inherits": "android_base", "cacheVariables": { "CMAKE_ANDROID_ARCH_ABI": "x86_64" } },
        { "name": "android_ndk_x86", "inherits": "android_base", "cacheVariables": { "CMAKE_ANDROID_ARCH_ABI": "x86" } },
        {
            "name": "windows_msvc_x86_64",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": { "value": "x64", "strategy": "set" },
            "toolset": { "value": "host=x64", "strategy": "set" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "windows_llvm_mingw_base",
            "hidden": true,
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/llvm_mingw.cmake",
            "cacheVariables": { "CMAKE_SYSTEM_NAME": "Windows" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        { "name": "windows_llvm_mingw_i686", "inherits": "windows_llvm_mingw_base", "cacheVariables": { "CMAKE_SYSTEM_PROCESSOR": "i686" } },
        { "name": "windows_llvm_mingw_x86_64", "inherits": "windows_llvm_mingw_base", "cacheVariables": { "CMAKE_SYSTEM_PROCESSOR": "x86_64" } },
        { "name": "windows_llvm_mingw_aarch64", "inherits": "windows_llvm_mingw_base", "cacheVariables": { "CMAKE_SYSTEM_PROCESSOR": "aarch64" } },
        {
            "name": "wasm_emscripten_wasm32",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/emscripten.cmake",
            "cacheVariables": { "CMAKE_CXX_CLANG_TIDY": "" }
        },
        {
            "name": "linux_clang_x86_64",
            "inherits": "base",
            "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "linux_gcc_x86_64",
            "inherits": "base",
            "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        }
    ],
    "buildPresets": [
        { "name": "release", "hidden": true, "configuration": "Release" },
        { "name": "debug", "hidden": true, "configuration": "Debug" },
        { "name": "android_ndk_arm64_v8a_release", "configurePreset": "android_ndk_arm64_v8a", "inherits": "release" },
        { "name": "android_ndk_armeabi_v7a_release", "configurePreset": "android_ndk_armeabi_v7a", "inherits": "release" },
        { "name": "android_ndk_x86_64_release", "configurePreset": "android_ndk_x86_64", "inherits": "release" },
        { "name": "android_ndk_x86_release", "configurePreset": "android_ndk_x86", "inherits": "release" },
        { "name": "windows_msvc_x86_64_release", "configurePreset": "windows_msvc_x86_64", "inherits": "release" },
        { "name": "windows_msvc_x86_64_debug", "configurePreset": "windows_msvc_x86_64", "inherits": "debug" },
        { "name": "windows_llvm_mingw_i686_release", "configurePreset": "windows_llvm_mingw_i686", "inherits": "release" },
        { "name": "windows_llvm_mingw_x86_64_release", "configurePreset": "windows_llvm_mingw_x86_64", "inherits": "release" },
        { "name": "windows_llvm_mingw_aarch64_release", "configurePreset": "windows_llvm_mingw_aarch64", "inherits": "release" },
        { "name": "wasm_emscripten_wasm32_release", "configurePreset": "wasm_emscripten_wasm32", "inherits": "release" },
        { "name": "wasm_emscripten_wasm32_debug", "configurePreset": "wasm_emscripten_wasm32", "inherits": "debug" },
        { "name": "linux_clang_x86_64_release", "configurePreset": "linux_clang_x86_64", "inherits": "release" },
        { "name": "linux_clang_x86_64_debug", "configurePreset": "linux_clang_x86_64", "inherits": "debug" },
        { "name": "linux_clang_x86_64_docs", "configurePreset": "linux_clang_x86_64", "inherits": "release", "targets": ["docs"] },
        { "name": "linux_gcc_x86_64_release", "configurePreset": "linux_gcc_x86_64", "inherits": "release" },
        { "name": "linux_gcc_x86_64_debug", "configurePreset": "linux_gcc_x86_64", "inherits": "debug" }
    ],
    "testPresets": [
        {
            "name": "test_base",
            "hidden": true,
            "output": { "outputOnFailure": true, "verbosity": "default" },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        { "name": "windows_msvc_x86_64_release", "configurePreset": "windows_msvc_x86_64", "inherits": "test_base", "configuration": "Release" },
        { "name": "windows_msvc_x86_64_debug", "configurePreset": "windows_msvc_x86_64", "inherits": "test_base", "configuration": "Debug" },
        { "name": "linux_clang_x86_64_release", "configurePreset": "linux_clang_x86_64", "inherits": "test_base", "configuration": "Release" },
        { "name": "linux_clang_x86_64_debug", "configurePreset": "linux_clang_x86_64", "inherits": "test_base", "configuration": "Debug" },
        { "name": "linux_gcc_x86_64_release", "configurePreset": "linux_gcc_x86_64", "inherits": "test_base", "configuration": "Release" },
        { "name": "linux_gcc_x86_64_debug", "configurePreset": "linux_gcc_x86_64", "inherits": "test_base", "configuration": "Debug" },
        { "name": "wasm_emscripten_wasm32_release", "configurePreset": "wasm_emscripten_wasm32", "inherits": "test_base", "configuration": "Release" }
    ],
    "packagePresets": [
        { "name": "windows_msvc_x86_64_release", "configurePreset": "windows_msvc_x86_64", "configurations": ["Release"], "generators": ["ZIP"] },
        { "name": "windows_llvm_mingw_i686_release", "configurePreset": "windows_llvm_mingw_i686", "configurations": ["Release"], "generators": ["TXZ"] },
        { "name": "windows_llvm_mingw_x86_64_release", "configurePreset": "windows_llvm_mingw_x86_64", "configurations": ["Release"], "generators": ["TXZ"] },
        { "name": "windows_llvm_mingw_aarch64_release", "configurePreset": "windows_llvm_mingw_aarch64", "configurations": ["Release"], "generators": ["TXZ"] },
        { "name": "linux_clang_x86_64_release", "configurePreset": "linux_clang_x86_64", "configurations": ["Release"], "generators": ["TGZ"] },
        { "name": "linux_gcc_x86_64_release", "configurePreset": "linux_gcc_x86_64", "configurations": ["Release"], "generators": ["TGZ"] }
    ],
    "workflowPresets": [
        {
            "name": "android_ndk_arm64_v8a_release",
            "steps": [
                { "type": "configure", "name": "android_ndk_arm64_v8a" },
