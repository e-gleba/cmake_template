// SteamPipe app build script — GENERATED by CMake from
// cmake/steampipe/app_build.vdf.in; edit the template, re-configure.
// Docs: https://partner.steamgames.com/doc/sdk/uploading
//
// Usage (relative paths resolve against this file's directory):
//   steamcmd +login <steam_user> +run_app_build app_build.vdf +quit
"appbuild"
{
    // CT_STEAM_APP_ID — 480 is Spacewar, Valve's test app.
    "appid"         "@CT_STEAM_APP_ID@"
    // Tracks project() VERSION on every configure.
    "desc"          "@PROJECT_NAME@ @PROJECT_VERSION@"
    // 1 = dry run: validate only, upload nothing. Set "0" to upload.
    "preview"       "1"
    // steamcmd chunk cache + logs.
    "buildoutput"   "output/"
    // Staged depot content root — see the depot_*.vdf scripts.
    "contentroot"   "content/"
    // Branch to set live after upload ("" = none; never "default").
    "setlive"       ""

    "depots"
    {
        // Keys here and DepotID inside each depot_*.vdf come from the
        // same CT_STEAM_DEPOT_ID_* variables — they cannot drift apart.
        "@CT_STEAM_DEPOT_ID_WINDOWS@"   "depot_windows_x86_64.vdf"
        "@CT_STEAM_DEPOT_ID_LINUX@"     "depot_linux_x86_64.vdf"
    }
}
