// Depot script — Linux x86_64 (Steam Linux Runtime 4.0 / steamrt4).
// GENERATED by CMake from cmake/steampipe/depot_linux_x86_64.vdf.in.
// Stage the CPack ZIP contents (CI artifact
// steam-depot-linux_steamrt4_x86_64 or a local *_release_package ZIP)
// into the contentroot before upload.
"DepotBuild"
{
    "DepotID"       "@CT_STEAM_DEPOT_ID_LINUX@"
    // Overrides the app script's contentroot for this depot.
    "contentroot"   "content/linux_x86_64/"

    "FileMapping"
    {
        "LocalPath"     "*"
        "DepotPath"     "."
        "recursive"     "1"
    }

    // Keep symbols local — ship lean depots.
    "FileExclusion" "*.dbg"
    "FileExclusion" "*.debug"
}
