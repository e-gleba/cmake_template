// Depot script — Linux x86_64 (Steam Linux Runtime 4.0 / steamrt4).
// Stage the CPack ZIP contents (steam-depot-linux_steamrt4_x86_64 CI
// artifact) into the contentroot below before running app_build.vdf.
"DepotBuild"
{
    // Replace with your real Linux depot ID (here AND in app_build.vdf).
    "DepotID"       "4802"
    "contentroot"   "../build/steam/content/linux_x86_64/"

    "FileMapping"
    {
        "LocalPath"     "*"
        "DepotPath"     "."
        "recursive"     "1"
    }

    // Keep symbols local — ship lean depots.
    "FileExclusion" "*.dbg"
    "FileExclusion" "*.debug"
}
