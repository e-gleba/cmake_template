// Depot script — Windows x86_64.
// Stage the CPack ZIP contents (steam-depot-windows_* CI artifacts) into the
// contentroot below before running app_build.vdf.
"DepotBuild"
{
    // Replace with your real Windows depot ID (here AND in app_build.vdf).
    "DepotID"       "4801"
    "contentroot"   "../build/steam/content/windows_x86_64/"

    "FileMapping"
    {
        "LocalPath"     "*"
        "DepotPath"     "."
        "recursive"     "1"
    }

    // Keep symbols local — ship lean depots.
    "FileExclusion" "*.pdb"
}
