/// Driver id. clang-cl vs llvm-clang is a *driver* distinction (which
/// binary CMake found), so it keys on compiler_frontend straight from
/// CMake's compiler detection — macros alone cannot tell them apart
/// (clang++ targeting MSVC also defines _MSC_VER).
/// See: https://cmake.org/cmake/help/latest/variable/CMAKE_LANG_COMPILER_FRONTEND_VARIANT.html
[[nodiscard]] consteval std::string_view driver_id() noexcept
{
#if defined(__clang__)
    if constexpr (compiler_frontend == std::string_view{ "MSVC" }) {
        return "clang-cl";
    } else {
        return "llvm-clang";
    }
#elif defined(__GNUC__)
    return "gcc";
#elif defined(_MSC_VER)
    return "msvc";
#else
    return "unknown";
#endif
}

/// Precise compiler version string.
/// See: https://en.cppreference.com/w/cpp/preprocessor/replace
/// See: https://clang.llvm.org/docs/LanguageExtensions.html
[[nodiscard]] consteval std::string_view compiler_version() noexcept
{
#if defined(__clang__)
    return __clang_version__;
#elif defined(__GNUC__)
    return TB_STR(__GNUC__) "." TB_STR(__GNUC_MINOR__) "." TB_STR(
        __GNUC_PATCHLEVEL__);
#elif defined(_MSC_VER)
    return TB_STR(_MSC_FULL_VER);
#else
    return "unknown";
#endif
}

/// Standard library id from config macros.
/// See: https://en.cppreference.com/w/cpp/standard_library
/// See: https://libcxx.llvm.org/docs/DesignDocs/FeatureTestMacros.html
[[nodiscard]] consteval std::string_view stdlib_id() noexcept
{
#if defined(_LIBCPP_VERSION)
    return "libc++";
#elif defined(__GLIBCXX__)
    return "libstdc++";
#elif defined(_MSVC_STL_VERSION)
    return "msvc-stl";
#else
    return "unknown";
#endif
}

/// Standard library version from config macros.
/// See: https://en.cppreference.com/w/cpp/standard_library
[[nodiscard]] consteval std::string_view stdlib_version() noexcept
{
#if defined(_LIBCPP_VERSION)
    return TB_STR(_LIBCPP_VERSION);
#elif defined(__GLIBCXX__)
    return TB_STR(__GLIBCXX__);
#elif defined(_MSVC_STL_VERSION)
    return TB_STR(_MSVC_STL_VERSION);
#else
    return "unknown";
#endif
}

/// Value of __cplusplus.
/// See: https://en.cppreference.com/w/cpp/preprocessor/replace
[[nodiscard]] consteval std::string_view cxx_standard() noexcept
{
#ifdef __cplusplus
    return TB_STR(__cplusplus);
#else
    return "unknown";
#endif
}

/// OS id, covers windows, android, ios, ios-sim, macos, linux.
/// See: https://en.cppreference.com/w/cpp/preprocessor/conditional
/// See: https://developer.apple.com/documentation/xcode/conditional-compilation
[[nodiscard]] consteval std::string_view os_id() noexcept
{
#if defined(_WIN64) || defined(_WIN32)
    return "windows";
#elif defined(__ANDROID__)
    return "android";
#elif defined(__APPLE__)
#if defined(TARGET_OS_SIMULATOR) && TARGET_OS_SIMULATOR
    return "ios-sim";
#elif defined(TARGET_OS_IPHONE) && TARGET_OS_IPHONE
    return "ios";
#elif defined(TARGET_OS_MAC) && TARGET_OS_MAC
    return "macos";
#else
    return "apple";
#endif
#elif defined(__linux__)
    return "linux";
#else
    return "unknown";
#endif
}

/// CPU arch id.
/// See: https://en.cppreference.com/w/cpp/preprocessor/conditional
/// See: https://learn.microsoft.com/en-us/cpp/preprocessor/predefined-macros
[[nodiscard]] consteval std::string_view arch_id() noexcept
{
#if defined(__x86_64__) || defined(_M_X64)
    return "x86_64";
#elif defined(__aarch64__) || defined(_M_ARM64)
    return "aarch64";
#elif defined(__i386__) || defined(_M_IX86)
    return "x86";
#elif defined(__arm__) || defined(_M_ARM)
    return "arm";
#elif defined(__riscv) || defined(__riscv__)
    return "riscv";
#else
    return "unknown";
#endif
}

/// Byte order of the target platform, spelled out.
/// See: https://en.cppreference.com/w/cpp/types/endian
[[nodiscard]] consteval std::string_view endian_id() noexcept
{
    if constexpr (std::endian::native == std::endian::little) {
        return "little-endian";
    } else if constexpr (std::endian::native == std::endian::big) {
        return "big-endian";
    } else {
        return "mixed-endian";
    }
}

/// Relocatable code model of this translation unit.
/// pie = position-independent executable (-fPIE), pic = shared-library
/// style (-fPIC), static = fixed load address.
/// See: https://gcc.gnu.org/onlinedocs/gcc/Code-Gen-Options.html
[[nodiscard]] consteval std::string_view pic_mode() noexcept
{
#if defined(__PIE__)
    return "pie";
#elif defined(__PIC__)
    return "pic";
#else
    return "static";
#endif
}

/// C++ abstract data model from sizeof(short, int, long, long long, void*).
/// Letters name types widened to 64 bit: I = int, L = long, LL = long long,
/// P = pointer. short stays 16 bit except SILP64.
/// Models: SILP64 short/int/long/ptr = 64, ILP64 int/long/ptr = 64,
/// LP64 long/ptr = 64 (unix 64 bit), LLP64 long-long/ptr = 64 (windows 64 bit),
/// ILP32 int/long/ptr = 32, LP32 long/ptr = 32 with 16 bit int (16 bit dos).
/// See: https://en.cppreference.com/w/cpp/language/types
/// See: https://en.cppreference.com/w/cpp/types/climits
/// See:
/// https://learn.microsoft.com/en-us/windows/win32/winprog64/abstract-data-models
[[nodiscard]] consteval std::string_view data_model() noexcept
{
    if constexpr (sizeof(short) == 8 && sizeof(int) == 8 && sizeof(long) == 8 &&
                  sizeof(long long) == 8 && sizeof(void*) == 8) {
        return "SILP64";
    } else if constexpr (sizeof(int) == 8 && sizeof(long) == 8 &&
                         sizeof(void*) == 8) {
        return "ILP64";
    } else if constexpr (sizeof(short) == 2 && sizeof(int) == 4 &&
                         sizeof(long) == 8 && sizeof(long long) == 8 &&
                         sizeof(void*) == 8) {
        return "LP64";
    } else if constexpr (sizeof(short) == 2 && sizeof(int) == 4 &&
                         sizeof(long) == 4 && sizeof(long long) == 8 &&
                         sizeof(void*) == 8) {
        return "LLP64";
    } else if constexpr (sizeof(short) == 2 && sizeof(int) == 4 &&
                         sizeof(long) == 4 && sizeof(long long) == 8 &&
                         sizeof(void*) == 4) {
        return "ILP32";
    } else if constexpr (sizeof(short) == 2 && sizeof(int) == 2 &&
                         sizeof(long) == 4 && sizeof(void*) == 4) {
        return "LP32";
    } else {
        return "unknown";
    }
}

/// Feature set kept to abi-relevant toggles.
/// See: https://en.cppreference.com/w/cpp/preprocessor/conditional
/// See: https://en.cppreference.com/w/cpp/error/exception
/// See: https://en.cppreference.com/w/cpp/language/typeid
constexpr std::string_view cpp_features =
#if defined(_CPPUNWIND) || defined(__EXCEPTIONS)
    "+exceptions"
#else
    "-exceptions"
#endif
#if defined(_CPPRTTI) || defined(__GXX_RTTI)
    " +rtti"
#else
    " -rtti"
#endif
#if defined(__STDCPP_THREADS__) || defined(_REENTRANT) || defined(_MT)
    " +threads"
#else
    " -threads"
#endif
    ;

/// Wall-clock moment this translation unit was compiled (compiler clock,
/// re-stamped on every rebuild). Distinct from timestamp_utc above, which
/// is stamped once at CMake configure time.
/// See: https://en.cppreference.com/w/cpp/preprocessor/replace
[[nodiscard]] consteval std::string_view compile_stamp() noexcept
{
    return __DATE__ " " __TIME__;
}

/// Format a CMake ;-list as one aligned line: "N items: [a, b, c]".
/// One ranges pipeline serves both implicit lib/dir lists below.
/// See: https://en.cppreference.com/w/cpp/ranges/split_view
[[nodiscard]] std::string format_list(std::string_view raw)
{
    if (raw.empty() || raw == "n/a") {
        return "n/a";
    }
    std::vector<std::string_view> parts;
    for (auto const part : raw | std::views::split(';')) {
        parts.emplace_back(part.begin(), part.end());
    }
    std::ostringstream out;
    out << parts.size() << " items: [";
    bool first{ true };
    for (std::string_view const item : parts) {
        if (!first) {
            out << ", ";
        }
        first = false;
        out << item;
    }
    out << "]";
    return std::move(out).str();
}

struct report_builder final
{
    std::ostringstream os_;

    void line(std::initializer_list<std::string_view> parts)
    {
        for (std::string_view const part : parts) {
            os_ << part;
        }
        os_ << '\n';
    }

    void list(std::string_view label, std::string_view raw)
    {
        // "{:<11}: {}\n" without fmt: pad the label, then the value.
        os_ << label;
        for (std::size_t i{ label.size() }; i < 11; ++i) {
            os_ << ' ';
        }
        os_ << ": " << format_list(raw) << '\n';
    }

    [[nodiscard]] std::string str() && { return std::move(os_).str(); }
};

[[nodiscard]] std::string make_report()
{
    report_builder b;
    b.line({ "project    : ", project_name, " ", project_version });
    b.line({ "toolchain  : ",
             driver_id(),
             " ",
             compiler_version(),
             " / ",
             stdlib_id(),
             " ",
             stdlib_version(),
             " / __cplusplus ",
             cxx_standard(), });
    b.line({ "platform   : ",
             os_id(),
             " ",
             arch_id(),
             " ",
             endian_id(),
             " ",
             data_model(),
             " ",
             pic_mode(), });
    b.line({ "compiler   : ",
             "path=",
             compiler_path,
             " triple=",
             compiler_target,
             " frontend_variant=",
             compiler_frontend,
             " simulate=",
             compiler_simulate,
             " launcher=",
             compiler_launcher, });
    b.line({ "features   : ", cpp_features });
    b.line({ "build      : ",
             cmake_version,
             " ",
             generator,
             " type=",
             build_type,
             " cross=",
             crosscompiling,
             " sysroot=",
             sysroot, });
    b.line({ "install    : prefix=", install_prefix, });
    b.line(
        { "git        : ", git_sha, " (", git_dirty, ") @ ", timestamp_utc });
    b.line({ "compiled   : ", compile_stamp(), " (compiler clock)" });
    b.list("cxx_libs", cxx_link_libs);
    b.list("cxx_dirs", cxx_link_dirs);
    return std::move(b).str();
}

} // namespace detail

/// Returns cached build report, views static storage.
[[nodiscard]] std::string_view get_build_report()
{
    static const std::string storage = [] {
        try {
            return detail::make_report();
        } catch (...) {
            return std::string{ "<build report unavailable>" };
        }
    }();
    return storage;
}

